{
  "name": "sysradio",
  "private": true,
  "version": "0.2.1",
  "description": "Internet radio player for Windows and macOS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SysSteve/sysradio.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "tauri": "tauri",
    "app": "tauri dev",
    "tokens": "node scripts/tokens.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml -p streamproxy",
    "check:rust": "sh scripts/cargo-docker.sh",
    "test:e2e:docker": "sh scripts/e2e-docker.sh",
    "screens": "SCREENS=1 sh scripts/e2e-docker.sh e2e/screenshots.spec.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm test:rust"
  },
  "dependencies": {
    "@lucide/svelte": "1.55.0",
    "@tauri-apps/api": "2.12.3",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-global-shortcut": "2.4.1",
    "@tauri-apps/plugin-opener": "2.7.1",
    "@tauri-apps/plugin-store": "2.5.0",
    "@tauri-apps/plugin-window-state": "2.5.0",
    "hls.js": "1.7.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tauri-apps/cli": "2.12.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "22.20.5",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
