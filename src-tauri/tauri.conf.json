{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysRadio",
  "version": "../package.json",
  "identifier": "de.syssteve.sysradio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SysRadio",
        "width": 380,
        "height": 600,
        "minWidth": 320,
        "minHeight": 420,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Music",
    "shortDescription": "Small internet radio player",
    "longDescription": "SysRadio plays internet radio stations from the free radio-browser.info directory: favourites, search, tray, media keys and now-playing titles.",
    "copyright": "© 2026 SysSteve",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German", "English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
