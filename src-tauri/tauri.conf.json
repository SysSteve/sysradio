{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysRadio",
  "version": "../package.json",
  "identifier": "de.syssteve.sysradio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SysRadio",
        "url": "index.html",
        "width": 400,
        "height": 640,
        "minWidth": 320,
        "minHeight": 420,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "mini",
        "title": "SysRadio Mini",
        "url": "mini.html",
        "width": 380,
        "height": 104,
        "minWidth": 200,
        "minHeight": 64,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "shadow": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: http://127.0.0.1:*",
        "media-src": "'self' blob: http://127.0.0.1:*",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:*",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Music",
    "shortDescription": "Internet radio player",
    "longDescription": "SysRadio plays internet radio from the free radio-browser.info directory: favorites, search by country, region, language and genre, your own stream URLs, equalizer, floating player, tray, media keys and now-playing titles.",
    "copyright": "© 2026 SysSteve",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["German", "English", "Spanish", "French"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGMTVBMjkwQThGNUI4MzkKUldRNXVQV29rS0lWM3k3VmZvdzRqdDZXZVdxWVNtenN4ckdHaWxMNWJzZWhxTkx0ZlhBZXR5R3oK",
      "endpoints": ["https://github.com/SysSteve/sysradio/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
